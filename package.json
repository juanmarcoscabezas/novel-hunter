{
  "name": "wtr-lab-downloader",
  "version": "1.0.0",
  "description": "Scraper & Downloader para WTR-Lab con soporte Gemini, Google Translate, TXT, PDF y fusión de capítulos",
  "main": "electron/main.js",
  "type": "module",
  "bin": {
    "wtr": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "wtr": "node bin/cli.js",
    "dev": "electron .",
    "electron": "electron .",
    "build:icon": "electron scripts/generate_icon.cjs --no-sandbox --headless",
    "test": "node test/verify.js",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:installer": "electron-builder --win nsis --x64",
    "dist": "electron-builder --win --x64",
    "open:dist": "explorer.exe dist"
  },
  "build": {
    "appId": "com.novelhunter.app",
    "productName": "Novel Hunter",
    "artifactName": "Novel_Hunter_${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/assets/icon.png",
      "artifactName": "Novel_Hunter_${version}.${ext}"
    },
    "portable": {
      "artifactName": "Novel_Hunter_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Novel Hunter",
      "artifactName": "Novel_Hunter_${version}.${ext}"
    }
  },
  "keywords": [
    "wtr-lab",
    "novel",
    "scraper",
    "downloader",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "node-edge-tts": "^1.2.12",
    "pdfkit": "^0.16.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
