{
  "name": "wtr-lab-downloader",
  "version": "1.0.0",
  "description": "Scraper & Downloader para WTR-Lab con soporte Gemini, Google Translate, TXT, PDF y fusión de capítulos",
  "main": "electron/main.js",
  "type": "module",
  "bin": {
    "wtr": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "wtr": "node bin/cli.js",
    "electron": "electron .",
    "test": "node test/verify.js",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:installer": "electron-builder --win nsis --x64",
    "dist": "electron-builder --win --x64",
    "open:dist": "explorer.exe dist"
  },
  "build": {
    "appId": "com.wtrlab.downloader",
    "productName": "WTR-Lab Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WTR-Lab Downloader"
    }
  },
  "keywords": [
    "wtr-lab",
    "novel",
    "scraper",
    "downloader",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "pdfkit": "^0.16.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
